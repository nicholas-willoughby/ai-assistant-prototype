# Taipan AI Assistant Configuration
# 다음을 설정하고 저장하세요.

# GitHub Copilot API Key
# 설정 방법: https://github.com/settings/tokens
COPILOT_API_KEY=your_github_copilot_api_key_here

# 선택사항: 다른 LLM 사용
# OPENAI_API_KEY=your_openai_api_key
# AZURE_OPENAI_KEY=your_azure_key
# AZURE_OPENAI_ENDPOINT=your_azure_endpoint

# 팀 설정
TEAM_NAME=Innovation Team
TEAM_MEMBERS=10
TEAM_EMAIL_PREFIX=innovation

# KPI 관련
KPI_REVIEW_FREQUENCY=weekly
KPI_ALERT_THRESHOLD_YELLOW=50
KPI_ALERT_THRESHOLD_RED=30

# 보고서 설정
REPORT_SUBMISSION_DAY=monday
REPORT_SUBMISSION_TIME=09:00
REPORT_FORMAT=markdown

# Teams 연동 (선택사항)
TEAMS_WEBHOOK_URL=https://your_teams_webhook_url
TEAMS_CHANNEL_ID=your_channel_id

# Slack 연동 (선택사항)
SLACK_BOT_TOKEN=xoxb-your-slack-token
SLACK_CHANNEL_ID=C123456

# 데이터 저장 경로
DATA_STORAGE_PATH=./data
LOG_PATH=./logs

# 디버그 모드
DEBUG=false
LOG_LEVEL=INFO
